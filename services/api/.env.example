# Copy to .env for local development. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Base log level for pino (trace|debug|info|warn|error|fatal)
LOG_LEVEL=info

# Matches docker-compose.yml's postgres service. 127.0.0.1, not localhost —
# on WSL2, localhost can resolve to ::1 and hit a stale wslrelay.exe
# forward left over from a container restart, which accepts the TCP
# connection instantly then never relays any protocol data (ADR-0034).
# 127.0.0.1 sidesteps it and is equally correct on any other platform.
DATABASE_URL=postgresql://auctionx:auctionx_dev_password@127.0.0.1:5432/auctionx

# Generate your own for local dev: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never reuse a dev secret in a real deployment.
JWT_ACCESS_SECRET=replace-with-a-generated-32+-char-secret

# Optional — defaults to this same value if unset. Matches docker-compose.yml's
# redis service, which deliberately publishes to host port 6380, not Redis's
# default 6379 — see that file's comment (ADR-0028): on at least one dev
# machine, WSL2's own localhost-forwarding collided with Docker's on 6379,
# silently routing the app to a different, unrelated Redis instance.
# Also 127.0.0.1 for the same reason as DATABASE_URL above (ADR-0034) — the
# code also has its own defense in depth here, since infrastructure/
# redis/client.ts sets a commandTimeout so a Redis connection that's gone
# stale this way fails fast and falls into the rate limiter's existing
# fail-open path, instead of hanging every /api/v1/auth/* request forever.
REDIS_URL=redis://127.0.0.1:6380

# Optional — omit both to fall back to logging reset emails instead of sending them.
# GMAIL_APP_PASSWORD is NOT your Google account password: enable 2FA on the account,
# then generate one at https://myaccount.google.com/apppasswords
# GMAIL_USER=your-address@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# Where the reset-password link points. No frontend exists yet — this is a
# placeholder contract until apps/web has a page to receive it.
FRONTEND_URL=http://localhost:3000

# Optional — defaults to this same value if unset. Matches docker-compose.yml's
# redpanda service (Kafka-API-compatible). 127.0.0.1 for the same reason as
# DATABASE_URL/REDIS_URL above (ADR-0034).
KAFKA_BROKERS=127.0.0.1:9092

# Optional — defaults to this same value if unset. Matches docker-compose.yml's
# opensearch service. Search degrades gracefully (503 SEARCH_UNAVAILABLE) if
# unreachable — everything else keeps working (Section 25/40). 127.0.0.1 for
# the same reason as DATABASE_URL/REDIS_URL above (ADR-0034).
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_AUCTIONS_INDEX=auctions

# Optional — defaults to these same values if unset. Matches docker-compose.yml's
# ollama service (Phase 10, ADR-0032). Free/self-hosted by design — no API
# key needed. Run `npm run ai:pull-model --workspace=services/api` once after
# `docker compose up` to actually download the model into the container; the
# service itself boots fine before that, valuation just stays PENDING/FAILED
# until it's been pulled. 127.0.0.1 for the same reason as
# DATABASE_URL/REDIS_URL above (ADR-0034).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=moondream

# Optional — defaults to these same values if unset. Matches docker-compose.yml's
# s3mock service (MEDIA-001, ADR-0022). 127.0.0.1 for the same reason as
# DATABASE_URL/REDIS_URL above (ADR-0034) — this one bites hardest of all of
# them, since S3_ENDPOINT is baked directly into the presigned POST URL
# handed to the BROWSER (infrastructure/storage/presign.ts): a stale relay
# here breaks every image upload with no server-side error at all, because
# the presign call itself never touches the network — only the browser's
# own upload to the returned URL fails.
S3_ENDPOINT=http://127.0.0.1:9090
S3_PUBLIC_URL_BASE=http://127.0.0.1:9090/auctionx-media

# Optional — defaults to 10 (the real production value) if unset. register/
# login/refresh are keyed by IP alone (pre-authentication has no account
# identity to key by), so every account tested from one dev machine shares
# this one bucket per 15-minute window. Bump it here ONLY in your own local
# .env while doing heavy manual testing — never raise the default checked in
# here, since that's what a real deployment falls back to if unset.
# AUTH_RATE_LIMIT_MAX=10

# Uploaded-document scanning (ADR-0043). "basic" = built-in content checks.
# "clamav" also streams files to a clamd daemon and fails closed if it is
# unreachable: docker compose --profile scan up clamav
DOCUMENT_SCAN=basic
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Stripe Checkout (ADR-0044). TEST MODE ONLY: the API refuses to start with a
# live key. Leave unset to use the in-process mock payment provider.
# STRIPE_SECRET_KEY=sk_test_...
# From the Stripe dashboard > Developers > Webhooks, for the endpoint
# https://<your-api>/api/v1/webhooks/payments/stripe
# (events: checkout.session.completed, checkout.session.expired,
#  checkout.session.async_payment_succeeded, checkout.session.async_payment_failed)
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=usd
