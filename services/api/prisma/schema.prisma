generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

// The user domain's root entity. Owned exclusively by the future Auth/User
// module — no other module should read/write this table directly once we
// extract modules (Section 54).
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)

  // Nullable timestamp, not a boolean — same "has this happened yet"
  // convention as RefreshToken.revokedAt / PasswordResetToken.usedAt below.
  // Null means unverified. A soft gate (ADR pending): registering and
  // logging in never require this, but creating an auction or placing a bid
  // does (modules/auctions/service.ts, modules/bids/service.ts) — the two
  // places trust actually matters, per real product discussion 2026-09-30.
  emailVerifiedAt DateTime?
  // A seller an admin has decided to trust: their low-risk listings skip the
  // review queue (ADR-0041). Everyone starts false, so by default every
  // listing is reviewed; trust is granted per seller, audited, revocable.
  trustedSeller   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auctions                Auction[]
  bids                    Bid[]
  ordersAsSeller          Order[]                  @relation("OrdersAsSeller")
  ordersAsBuyer           Order[]                  @relation("OrdersAsBuyer")
  notifications           Notification[]

  @@map("users")
}

// One row per issued refresh token. tokenHash is SHA-256 of the opaque
// random token the client holds — a plain fast hash is correct here (unlike
// passwordHash) because the input is already 256 bits of random data, not a
// low-entropy human secret; there's no brute-force space to slow down.
//
// replacedByTokenId links one rotation step (old -> new). familyId is
// shared by every token descended from the same login, set once and copied
// forward on each rotation — it's what lets "revoke every token derived
// from this compromised one" be a single indexed UPDATE instead of an
// unbounded walk through replacedByTokenId pointers (a long-lived session
// refreshing every 15 min for the full 30-day window could chain through
// ~2,880 tokens).
//
// If a revoked token is ever presented again, that's a signal of token
// theft (attacker and legitimate user both hold a copy) — the whole family
// gets revoked (Section 41: don't add a mechanism without deciding what
// happens when it detects a problem).
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId          String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Single-use, short-lived (30 min). No rotation/family concept needed here
// unlike RefreshToken — a reset flow isn't a long-lived session, it's one
// attempt. Requesting a new reset invalidates any prior outstanding one for
// the same user (see repository.ts) so a stale, unused, unexpired token
// from an earlier email doesn't sit around as extra attack surface.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Identical shape to PasswordResetToken, deliberately — same single-use,
// hash-only-lookup opaque-token pattern (infrastructure/security/tokens.ts's
// generateOpaqueToken), just a longer TTL (24h vs 30min): a stolen
// verification link that only proves "this inbox exists" is far lower-
// stakes than a stolen password-reset link, so there's no reason to force
// the same tight window.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

enum AuctionStatus {
  DRAFT
  // Submitted by the seller, waiting for an admin to approve or reject it
  // (ADR-0041). Invisible to the public exactly like DRAFT. Approval moves
  // it straight to ACTIVE with the clock starting at approval time.
  PENDING_REVIEW
  PUBLISHED
  ACTIVE
  PAUSED
  CANCELLED
  ENDED
}

// Deliberately a small, fixed, code-controlled vocabulary rather than a
// lookup table — same YAGNI justification as Role/UserStatus above. Revisit
// only if categories need to be admin-editable at runtime or need hierarchy.
enum AuctionCategory {
  ART
  COLLECTIBLES
  JEWELRY
  WATCHES
  COINS_AND_CURRENCY
  MEMORABILIA
  BOOKS_AND_MANUSCRIPTS
  OTHER
}

enum AuctionCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

// The auction domain's root entity. Owned by the future Auctions module.
//
// Money is stored as integer cents, never Decimal/Float — floating point
// cannot represent money exactly, and integer minor units match the
// convention real payment providers (Phase 8) use, avoiding a conversion
// boundary between this module and Payments later.
//
// currentPriceCents exists already even though bidding doesn't (Phase 4) —
// the bid-placement transaction will update this column as part of the same
// atomic "persist bid + update auction state" step (Section 10), so it
// belongs on this table from the start rather than arriving as a later
// breaking migration. It starts equal to startingPriceCents.
//
// images is a placeholder contract (empty by default): object storage
// (Section 27) isn't built yet, but the eventual upload mechanism only ever
// needs to populate this array — no schema change required when it lands.
//
// seller uses onDelete: Restrict, not Cascade like RefreshToken/
// PasswordResetToken — an Auction is a business record, not a disposable
// session artifact. A user who has ever listed an auction cannot be deleted
// out from under that history.
model Auction {
  id       String @id @default(uuid())
  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  title       String
  description String
  category    AuctionCategory
  condition   AuctionCondition
  images      String[]         @default([])

  startingPriceCents Int
  reservePriceCents  Int?
  currentPriceCents  Int

  status AuctionStatus @default(DRAFT)

  // Nullable while DRAFT — a seller may not have scheduled the auction yet.
  // "must be set before publish" is enforced in the service layer, not here.
  startTime DateTime?
  endTime   DateTime?
  // Separate from endTime: endTime is the *planned* end (and can move —
  // anti-sniping extends it, Section 18); endedAt is when it *actually*
  // ended, which can diverge (early cancellation, extension). Collapsing
  // these would make "did this run its full course or end early" unrecoverable.
  endedAt   DateTime?

  // Review stage (ADR-0041). The seller picks a DURATION when submitting,
  // not an end time: an end time chosen now would be eaten by however long
  // the review takes. The clock (startTime/endTime) is set from this when
  // an admin approves. Who reviewed is NOT stored here: auctions are served
  // to the public as-is, and the audit log already records the reviewer.
  // reviewNote is the admin's rejection reason, shown to the seller (it only
  // exists while the auction is a non-public DRAFT, and is cleared on
  // approval).
  requestedDurationSeconds Int?
  submittedAt              DateTime?
  reviewedAt               DateTime?
  reviewNote               String?

  // True while an ADMIN has paused this auction (ADR-0041). A seller can
  // normally pause and resume their own auction, but must not be able to
  // lift a moderator's pause; cleared when the admin resumes or cancels it.
  heldByAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids      Bid[]
  order     Order?
  valuation AuctionValuation?
  documents AuctionDocument[]

  @@index([sellerId])
  @@index([status])
  // Matches the exact query the Phase 4 closing worker will run: active
  // auctions whose endTime has passed.
  @@index([status, endTime])
  @@map("auctions")
}

enum ValuationStatus {
  PENDING
  COMPLETE
  FAILED
}

// Phase 10 (Section 20/22, ADR-0032): AI-assisted valuation, computed
// asynchronously off Kafka — never on the auction-creation critical path
// (Section 24). One row per auction (@unique), created PENDING in the SAME
// transaction as the auction itself (modules/auctions/repository.ts's
// createAuction), then filled in by modules/ai/consumer.ts once the model
// call completes.
//
// The price fields and confidence are all nullable together: they're only
// meaningful once status is COMPLETE. A FAILED row keeps errorMessage for
// display and leaves the price fields null rather than a stale/fabricated
// zero.
//
// onDelete: Cascade, not Restrict like Auction.seller — this is a derived AI
// artifact tied 1:1 to its auction, not an independent business record (the
// same distinction Notification already draws for its own Cascade). Nothing
// in this schema currently deletes an Auction anyway.
model AuctionValuation {
  id        String          @id @default(uuid())
  auctionId String          @unique
  auction   Auction         @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  status    ValuationStatus @default(PENDING)

  estimatedValueCents Int?
  priceRangeLowCents  Int?
  priceRangeHighCents Int?
  // 0..1, the model's own self-reported confidence — inherently a soft
  // signal from a small local model, shown to the seller as a rough
  // indicator, never treated as a statistical guarantee anywhere in this
  // codebase.
  confidence          Float?
  explanation         String?
  // Which model produced this result (e.g. "moondream") — kept per-row
  // rather than assumed globally, since OLLAMA_VISION_MODEL can change
  // between when different rows were generated.
  model               String?
  errorMessage        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("auction_valuations")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// Why an order ended up CANCELLED (ADR-0038). PAYMENT_TIMEOUT is the
// unpaid-order worker; ADMIN is a manual moderation action. A buyer or
// seller cancelling their own order is deliberately not a thing yet.
enum OrderCancelReason {
  PAYMENT_TIMEOUT
  ADMIN
}

// Created exactly once, atomically, inside the same transaction that closes
// an auction (see closeAuctionIfExpired in modules/auctions/repository.ts) —
// not via an event/outbox. There is no cross-system boundary to cross yet
// (Order lives in the same Postgres database as Auction, and Kafka/Outbox,
// Section 16, doesn't exist until Phase 7), so a second write inside the
// same transaction is strictly simpler than publishing an event to create
// a row in a table one query away. Revisit if Order creation ever needs to
// react to something outside this monolith.
//
// auctionId is @unique, not just indexed — an auction can end at most once
// (closeAuctionIfExpired's own idempotency guarantees that already), so it
// can produce at most one Order, ever. That invariant belongs in the schema,
// not just in application logic.
//
// No Order row is created at all when there is no winner (no bids, or the
// highest bid didn't meet reservePriceCents) — see ORDER-002. An Order
// existing IS the "this auction has a winner who owes payment" signal;
// there's no separate boolean to keep in sync.
model Order {
  id           String  @id @default(uuid())
  auctionId    String  @unique
  auction      Auction @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  winningBidId String  @unique
  winningBid   Bid     @relation(fields: [winningBidId], references: [id], onDelete: Restrict)
  sellerId     String
  seller       User    @relation("OrdersAsSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  buyerId      String
  buyer        User    @relation("OrdersAsBuyer", fields: [buyerId], references: [id], onDelete: Restrict)

  amountCents Int

  status OrderStatus @default(PENDING_PAYMENT)

  // Post-auction lifecycle (ADR-0038). All nullable: each is only
  // meaningful once the order reaches the matching state, and `status` is
  // the single source of truth for "which state" (these are the details of
  // the transition, not a second state machine).
  //
  // paymentDueAt: set when the order is created; an unpaid order past this
  // is cancelled by the payment-deadline worker. Nullable only because
  // orders that predate this column are backfilled by the migration.
  paymentDueAt   DateTime?
  shippedAt      DateTime?
  carrier        String?
  trackingNumber String?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   OrderCancelReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([sellerId])
  @@index([buyerId])
  // The payment-deadline worker's scan: "unpaid orders past their due
  // date". Same shape/reasoning as Auction's [status, endTime] index.
  @@index([status, paymentDueAt])
  @@map("orders")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// One Order can have multiple Payment attempts (a FAILED one, then a retry)
// — that's why amountCents/status live on Payment, not folded onto Order,
// and why Order.status is the derived "does this order currently have a
// SUCCEEDED payment" summary rather than the payment record itself.
//
// providerRef + idempotencyKey are separate on purpose: idempotencyKey is
// OUR key, generated when we create the intent, used to make "create intent
// for this order" itself idempotent (Section 11 — a buyer double-clicking
// Pay must not create two intents). providerRef is THEIR id for the same
// object, always known synchronously (the provider call returns it before
// we ever write this row — see modules/payments/service.ts), needed to
// correlate an incoming webhook back to this row. Never trust a webhook's
// claimed amount against anything but this row's own amountCents (Section
// 19) — PaymentWebhookEvent (infrastructure/payments/provider.ts)
// deliberately carries no amount field at all, so there's nothing to
// mistakenly trust even if a future provider integration tried to.
//
// idempotencyKey is scoped PER ORDER (@@unique([orderId, idempotencyKey]),
// not a bare global unique) — the same pattern as Bid's
// @@unique([bidderId, idempotencyKey]) — because a fresh payment attempt
// after an earlier FAILED one is a legitimate new key, and scoping to the
// order (rather than relying on random-UUID-never-collides-globally) makes
// that intent explicit in the schema. Unlike Bid, this can't be enforced by
// holding one lock across the whole operation (Section 65 — never hold a
// Postgres row lock across an external network call to the payment
// provider), so the constraint itself is the race-breaker: two concurrent
// attempts both insert optimistically, the loser's insert fails with a
// unique violation, and the service layer catches that and returns the
// winner's row instead (see createPaymentIntentForOrder).
//
// providerRef + provider are also @@unique together: a provider's id is
// only unique within that provider's own namespace, and this is the exact
// pair a webhook uses to find its way back to a row.
model Payment {
  id          String @id @default(uuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider    String
  providerRef String

  amountCents Int
  status      PaymentStatus @default(PENDING)

  idempotencyKey String

  // Set when the money was returned to the buyer (ADR-0044). A SUCCEEDED
  // payment on a CANCELLED order with refundedAt null is a "needs refund".
  refundedAt DateTime?
  refundRef  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, idempotencyKey])
  @@unique([provider, providerRef])
  @@index([orderId])
  @@map("payments")
}

// Only ever holds ACCEPTED bids - a bid whose amount doesn't beat the
// current price is rejected at write time (BID-002) and never persisted, so
// there's nothing worth remembering about an attempt that never took
// effect. Consequently this table is append-only: never updated, never
// deleted. There's no `isWinning`/status column either - because every
// accepted bid must exceed the previous price by construction, the most
// recent bid for an auction IS the current highest one; no aggregate or
// flag needs to be kept in sync as new bids arrive.
model Bid {
  id        String  @id @default(uuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  bidderId  String
  bidder    User    @relation(fields: [bidderId], references: [id], onDelete: Restrict)

  amountCents Int

  // Scoped to the bidder, not globally unique - Section 11's idempotency
  // pattern applied to bid placement, which (unlike registration's email)
  // has no natural uniqueness key of its own. Matches how real payment
  // APIs scope idempotency keys to the caller, not the whole system.
  idempotencyKey String

  createdAt DateTime @default(now())

  order Order?

  @@unique([bidderId, idempotencyKey])
  // Matches "give me this auction's bid history, newest first" - the same
  // query that answers "what's the current highest bid" per the comment
  // above.
  @@index([auctionId, createdAt])
  @@index([bidderId])
  @@map("bids")
}

enum NotificationType {
  OUTBID
  AUCTION_WON
  AUCTION_SOLD
  AUCTION_RESERVE_NOT_MET
  PAYMENT_RECEIVED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  AUCTION_MODERATED
}

// Created synchronously, inside the SAME transaction as the event it
// reports (a bid being outbid, an auction closing, a payment webhook
// succeeding) — the same "no Outbox/Kafka needed yet, it's one Postgres
// database" reasoning as Order (ADR-0023). This table is the source of
// truth; a WebSocket push (infrastructure/websocket/gateway.ts's per-user
// rooms) is a best-effort, additive notice on top of it for a currently-
// connected client, never the only way a notification reaches someone —
// Section 39: delayed is fine, lost is not.
//
// auctionId/orderId are plain nullable strings, NOT Prisma relations with
// an enforced FK — unlike Order's relations (which protect real business
// correctness), a notification is read-mostly UI convenience data. A
// dangling reference here would be a rendering nuisance (a "view auction"
// link that 404s), not a correctness bug, so it doesn't need the same
// onDelete: Restrict machinery the rest of this schema uses for records
// that matter financially. In practice nothing in this schema currently
// deletes an Auction/Order anyway, so this is a deliberate simplification,
// not a gap being papered over.
model Notification {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  auctionId String?
  orderId   String?
  // Small, type-specific display data (e.g. the bid amount that outbid
  // them, the sale price) — kept as one JSON column rather than a column
  // per possible field across five different notification types, which
  // would mean most rows leave most columns null. A notification's payload
  // is read, never queried/filtered on, so there's no indexing reason to
  // normalize it further.
  data      Json

  // The OutboxEvent.id this notification was created from (ADR-0027) — NOT
  // a Prisma relation/FK (OutboxEvent rows are routinely deleted/archived
  // once published, see the retention note there; a notification must
  // survive that). This is what makes the Kafka consumer's Notification
  // creation idempotent: a redelivered message (Kafka is at-least-once,
  // Section 15) re-derives the SAME sourceEventId, and the compound unique
  // below turns a duplicate insert into a P2002 the consumer catches and
  // treats as a safe no-op — the same pattern bids/service.ts and
  // payments/service.ts already use for their own idempotency races.
  //
  // Scoped to (sourceEventId, userId), not a bare unique on sourceEventId
  // alone — a single event (e.g. "auction.sold") legitimately produces TWO
  // notifications, one per side (AUCTION_WON for the buyer, AUCTION_SOLD
  // for the seller); the pair must both be allowed to exist, while a
  // redelivery of that same event must not duplicate either one.
  sourceEventId String

  readAt DateTime?

  createdAt DateTime @default(now())

  // Matches "give me this user's notifications, newest first" — the only
  // query pattern this table serves.
  @@unique([sourceEventId, userId])
  @@index([userId, createdAt])
  @@map("notifications")
}

// The Outbox pattern (Section 16, ADR-0027): a durable, transactionally-
// consistent record of "this event happened," written in the SAME
// transaction as the domain change it describes (a bid being outbid, an
// auction closing, a payment succeeding) — never published to Kafka
// directly from request-handling code, which is exactly what Section 10/16
// warn against ("never publish a Kafka event and then assume the database
// transaction will succeed" — here it's the reverse risk: publish, then
// have the SURROUNDING transaction roll back, leaving an event for
// something that never actually happened).
//
// A separate polling worker (infrastructure/jobs/outboxPublisherWorker.ts)
// reads unpublished rows and publishes them to Kafka; a row is retried
// indefinitely (Section 40 — "Kafka fails, business transactions continue,
// Outbox preserves events") until it succeeds — there is no permanent
// "FAILED" state at this layer, because a Kafka publish failure is always
// transient/retryable, unlike a Payment, which can genuinely fail for
// good.
//
// No retention/cleanup job exists yet for old PUBLISHED rows — deferred
// (YAGNI) until table growth is an actually measured problem, not a
// theoretical one, at this project's current scale.
model OutboxEvent {
  id      String @id @default(uuid())
  // Kafka topic this event publishes to (e.g. "bid-events"). A plain
  // string, not an enum — new topics are expected to be added over time,
  // and a schema migration for each one would be friction with no benefit
  // (nothing here needs the database itself to constrain topic names).
  topic   String
  // The Kafka partition key — auctionId for bid/auction events, orderId
  // for payment events (Section 15: partition key exists specifically so
  // events that must stay ORDERED relative to each other land on the same
  // partition; payment events order per-order, not per-auction, so this
  // deliberately does NOT follow Section 15's literal auction_id example
  // for every topic).
  key     String
  payload Json

  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  // Claim-lease, added ADR-0029's revisit list / this fix: without this,
  // two concurrent outboxPublisherWorker instances (e.g. a live `npm run
  // dev` server left running alongside a test suite, both against the
  // same Postgres — a real thing that happened) could both SELECT the
  // same unpublished row and both publish it to Kafka, producing two
  // distinct messages for one logical event. `claimedAt` is stamped by a
  // SHORT transaction (SELECT ... FOR UPDATE SKIP LOCKED + UPDATE, held
  // only for that claim, never across the actual Kafka sends — Section 65)
  // before a row is published; a claim older than the worker's lease
  // window is treated as abandoned (the claiming process crashed) and
  // re-claimable by anyone.
  claimedAt DateTime?

  // The exact query the publisher worker runs: oldest unclaimed-or-
  // lease-expired unpublished events first, so a long Kafka/Redpanda
  // outage doesn't reorder delivery once it recovers.
  @@index([publishedAt, claimedAt, createdAt])
  @@map("outbox_events")
}

// Append-only record of every admin/moderation action (ADR-0039). Never
// updated, never deleted.
//
// No foreign keys, on purpose: an audit trail must outlive whatever it
// describes. With a real FK to User, deleting (or cascading) a user would
// either block on, or erase, the history of what was done to them. Plain
// string ids keep the record intact; the cost is that an id can dangle,
// which for an audit log is correct, not a defect.
//
// `action` is a free string for the same reason OutboxEvent.topic is: new
// admin actions will keep appearing and each shouldn't need a migration.
// `actorId` is null for actions taken outside the API (the make-admin CLI),
// recorded in `metadata.via`.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json
  createdAt  DateTime @default(now())

  // "Everything done to this user / auction / order, newest first".
  @@index([targetType, targetId, createdAt])
  // The audit log page itself: newest first across everything.
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// A supporting document for a listing (certificate, receipt, provenance),
// uploaded by the seller and read by the seller and admins only (ADR-0041).
// Stored in a PRIVATE bucket and only ever served through short-lived signed
// URLs, never a public URL: these routinely contain names, addresses and
// serial numbers. Rows only exist for objects that were confirmed to exist
// in the bucket when registered (the client's claimed size is never trusted).
// Cascade, unlike most FKs here: a document has no meaning without its
// auction. (The bucket object itself is not removed by the cascade.)
model AuctionDocument {
  id          String   @id @default(uuid())
  auctionId   String
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  uploaderId  String
  objectKey   String   @unique
  fileName    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([auctionId])
  @@map("auction_documents")
}
